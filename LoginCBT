<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Login CBT Olimpiade</title>
    
    <!-- Load Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Load Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Load Supabase JS Library -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 20px 20px;
        }
        
        /* Custom animation for the toast notification */
        @keyframes slideIn {
            from { transform: translateY(-100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .toast-enter {
            animation: slideIn 0.3s ease-out forwards;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

    <!-- Login Card Container -->
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden transform transition-all">
        
        <!-- Header Section -->
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 p-6 text-center">
            <div class="bg-white/20 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
                <!-- SVG Icon for Education/Test -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white">Portal CBT</h1>
            <p class="text-blue-100 text-sm mt-1">Olimpiade Matematika & IPA</p>
        </div>

        <!-- Form Section -->
        <div class="p-8">
            <form id="loginForm" class="space-y-6">
                <!-- Username Input -->
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                    <input type="text" id="username" name="username" required
                        class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors outline-none"
                        placeholder="Contoh: izzuddin03082017">
                </div>

                <!-- Password Input -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input type="password" id="password" name="password" required
                        class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors outline-none"
                        placeholder="Masukkan password Anda">
                </div>

                <!-- Submit Button -->
                <button type="submit" id="loginBtn"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 flex justify-center items-center">
                    <span id="btnText">Masuk Ujian</span>
                    <!-- Loading Spinner (Hidden by default) -->
                    <svg id="btnSpinner" class="animate-spin ml-2 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </form>
            
            <div class="mt-6 text-center text-sm text-gray-500">
                Gunakan username dan password yang telah diberikan oleh panitia.
            </div>
        </div>
    </div>

    <!-- Toast Notification Container (Custom Alert) -->
    <div id="toastContainer" class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 hidden">
        <div id="toastMessage" class="flex items-center px-4 py-3 rounded-lg shadow-lg text-white font-medium">
            <span id="toastIcon" class="mr-2"></span>
            <span id="toastText">Message goes here</span>
        </div>
    </div>

    <script>
        // ==========================================
        // 1. KONFIGURASI SUPABASE (GANTI DENGAN KUNCI ANDA)
        // ==========================================
        // Anda bisa mendapatkan URL dan Key ini di dashboard Supabase:
        // Project Settings -> API
        const SUPABASE_URL = 'https://YOUR_PROJECT_ID.supabase.co'; 
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        
        let supabase;
        // Initialize Supabase only if keys are provided (to prevent crashing in preview)
        if (SUPABASE_URL !== 'https://YOUR_PROJECT_ID.supabase.co') {
            supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }

        // ==========================================
        // 2. DOM ELEMENTS & UTILITIES
        // ==========================================
        const loginForm = document.getElementById('loginForm');
        const loginBtn = document.getElementById('loginBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        
        const toastContainer = document.getElementById('toastContainer');
        const toastMessage = document.getElementById('toastMessage');
        const toastText = document.getElementById('toastText');
        const toastIcon = document.getElementById('toastIcon');

        // Fungsi untuk menampilkan Custom Alert (Toast)
        function showToast(message, type = 'error') {
            toastText.textContent = message;
            
            if (type === 'error') {
                toastMessage.className = 'flex items-center px-6 py-3 rounded-lg shadow-lg font-medium bg-red-500 text-white toast-enter';
                toastIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
            } else if (type === 'success') {
                toastMessage.className = 'flex items-center px-6 py-3 rounded-lg shadow-lg font-medium bg-green-500 text-white toast-enter';
                toastIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
            } else if (type === 'warning') {
                toastMessage.className = 'flex items-center px-6 py-3 rounded-lg shadow-lg font-medium bg-yellow-500 text-white toast-enter';
                toastIcon.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
            }

            toastContainer.classList.remove('hidden');
            
            // Sembunyikan otomatis setelah 3 detik
            setTimeout(() => {
                toastContainer.classList.add('hidden');
            }, 3000);
        }

        // Fungsi mengatur status tombol loading
        function setLoading(isLoading) {
            if (isLoading) {
                btnText.textContent = 'Memproses...';
                btnSpinner.classList.remove('hidden');
                loginBtn.disabled = true;
                loginBtn.classList.add('opacity-70', 'cursor-not-allowed');
            } else {
                btnText.textContent = 'Masuk Ujian';
                btnSpinner.classList.add('hidden');
                loginBtn.disabled = false;
                loginBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        }

        // ==========================================
        // 3. LOGIKA LOGIN UTAMA
        // ==========================================
        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault(); // Mencegah reload halaman
            
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;

            // Jika API Key belum diubah, jalankan mode DEMO
            if (!supabase) {
                showToast('API Supabase belum di-setting! Menjalankan mode demo...', 'warning');
                setLoading(true);
                setTimeout(() => {
                    setLoading(false);
                    // Simulasi login sukses
                    localStorage.setItem('user_nama', 'Siswa Demo');
                    window.location.href = 'cbt_mtk.html'; 
                }, 1500);
                return;
            }

            setLoading(true);

            try {
                // Query ke Supabase untuk mencocokkan username & password
                const { data, error } = await supabase
                    .from('peserta')
                    .select('id, nama, mapel_lomba, status_ujian')
                    .eq('username', username)
                    .eq('password', password)
                    .single(); // Ambil 1 data spesifik

                if (error || !data) {
                    showToast('Username atau Password salah!', 'error');
                    setLoading(false);
                    return;
                }

                // Cek apakah siswa sudah selesai ujian
                if (data.status_ujian === 'selesai') {
                    showToast('Maaf, Anda sudah menyelesaikan ujian ini.', 'error');
                    setLoading(false);
                    return;
                }

                // Login Berhasil! Simpan sesi di LocalStorage browser
                localStorage.setItem('user_id', data.id);
                localStorage.setItem('user_nama', data.nama);
                localStorage.setItem('mapel_lomba', data.mapel_lomba);

                showToast(`Selamat datang, ${data.nama}!`, 'success');

                // Arahkan ke halaman ujian sesuai mapel (delay sedikit agar toast terlihat)
                setTimeout(() => {
                    if (data.mapel_lomba === 'Olimpiade Matematika') {
                        window.location.href = 'cbt_mtk.html';
                    } else if (data.mapel_lomba === 'Olimpiade IPA') {
                        window.location.href = 'cbt_ipa.html';
                    } else {
                        // Jika mapel tidak dikenali (mungkin PAI / B.Inggris belum dibuat HTML-nya)
                        showToast(`Halaman ujian untuk ${data.mapel_lomba} belum tersedia.`, 'warning');
                        setLoading(false);
                    }
                }, 1000);

            } catch (err) {
                console.error("Login error:", err);
                showToast('Terjadi kesalahan koneksi ke server.', 'error');
                setLoading(false);
            }
        });
    </script>
</body>
</html>
